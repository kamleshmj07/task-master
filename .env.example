# Copy to .env (repo root, for docker compose) and backend/.env (for the API).
# Use your own password; never commit .env files.

# docker compose
POSTGRES_USER=task_master
POSTGRES_PASSWORD=change-me
POSTGRES_DB=task_master

# backend
TASK_MASTER_DATABASE_URL=postgresql+asyncpg://task_master:change-me@localhost:5434/task_master
TASK_MASTER_TEST_DATABASE_URL=postgresql+asyncpg://task_master:change-me@localhost:5434/task_master_test
