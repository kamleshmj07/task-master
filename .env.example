# Copy to .env (repo root, for docker compose) and backend/.env (for the API).
# Use your own password; never commit .env files.

# docker compose
POSTGRES_USER=task_master
POSTGRES_PASSWORD=change-me
POSTGRES_DB=task_master

# backend
TASK_MASTER_DATABASE_URL=postgresql+asyncpg://task_master:change-me@127.0.0.1:5434/task_master
TASK_MASTER_TEST_DATABASE_URL=postgresql+asyncpg://task_master:change-me@127.0.0.1:5434/task_master_test

# Signs password-reset and verification tokens: python -c "import secrets; print(secrets.token_urlsafe(48))"
TASK_MASTER_AUTH_SECRET=change-me-too

# Optional, with the defaults shown. Uncomment to change.
# TASK_MASTER_ENVIRONMENT=development          # development | test | production
# TASK_MASTER_CORS_ORIGINS=["http://localhost:5173"]
# TASK_MASTER_AUTH_RATE_LIMIT=5/minute         # register and refresh, per IP
# TASK_MASTER_LOGIN_FREE_FAILURES=5            # failed logins before a lock
# TASK_MASTER_LOGIN_BASE_LOCK_SECONDS=60       # first lock; doubles per failure
# TASK_MASTER_LOGIN_MAX_LOCK_SECONDS=900
# TASK_MASTER_LOGIN_IP_FAILURES=20             # failures per IP per window
# TASK_MASTER_LOGIN_IP_WINDOW_SECONDS=900
# TASK_MASTER_COMPLETED_TASK_RETENTION_DAYS=90 # finished tasks and read notifications
