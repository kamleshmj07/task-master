    "/auth/web/refresh": {
      "post": {
        "tags": [
          "auth: web"
        ],
        "summary": "Handle Web Refresh",
        "description": "Swap the refresh cookie for a new access token and cookie.",
        "operationId": "handle_web_refresh_auth_web_refresh_post",
        "parameters": [
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
